{
  "name": "@sambat/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node init && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.0",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0"
  }
}
